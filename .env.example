# Copy to .env. The docker-compose defaults match these values, so the app
# connects to the local stack with no extra wiring.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Postgres (docker compose: postgis/postgis:16-3.4) -----------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5433/companion
DATABASE_POOL_MAX=10

# --- Redis (BullMQ, rate limits, Socket.io adapter, live location) -----------
REDIS_URL=redis://localhost:6380

# --- Object storage: MinIO locally, Cloudflare R2 in deploy ------------------
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=companion-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=auto

# --- CORS: the web and admin origins -----------------------------------------
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# --- Chain (step 4.2 wires these up; see the TODO in src/common/config/env.ts)
CHAIN_ID=84532
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_CONFIRMATIONS=5
# Never commit a real value. The operator key is a hot key with refund +
# keeper-release power only (architecture.md §5).
OPERATOR_PRIVATE_KEY=

# Privy — signs users in and creates their embedded Base wallet.
# The SECRET lives here and nowhere else; the app id is also in web/.env as
# NEXT_PUBLIC_PRIVY_APP_ID. Get both from dashboard.privy.io (docs/SERVICES.md).
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Youverify KYC. Keep the API key server-side. URL defaults to sandbox when
# omitted; production must be selected explicitly to avoid billable checks.
YOUVERIFY_API_KEY=
YOUVERIFY_BASE_URL=https://api.sandbox.youverify.co
