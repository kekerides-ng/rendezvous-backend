{
  "name": "rendezvous-backend",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate-database.ts",
    "db:check": "bun run scripts/check-database.ts",
    "db:studio": "drizzle-kit studio",
    "api:export": "bun run build && node scripts/export-openapi.mjs",
    "admin:create": "bun run scripts/create-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "12.2.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/websockets": "12.2.0",
    "@node-rs/argon2": "2.2.2",
    "@privy-io/server-auth": "^1.32.5",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "6.3.17",
    "cookie-parser": "1.4.7",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "otpauth": "9.5.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "@types/cookie-parser": "1.4.10",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
